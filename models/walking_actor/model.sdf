<?xml version="1.0" ?>
<sdf version="1.9">
  <actor name="walking_actor">
    <pose>0 0 0.86 0 0 0</pose>
    <plugin
      filename="libgz_human_actor_command.so"
      name="gz_human_sim::ActorCommandPlugin">
      <vel_topic>/cmd_vel</vel_topic>
      <path_topic>/cmd_path</path_topic>
      <remove_topic>/remove_actor</remove_topic>
      <follow_mode_topic>/set_follow_mode</follow_mode_topic>
      <jump_topic>/cmd_jump</jump_topic>
      <collision_model_name></collision_model_name>
      <collision_cmd_vel_topic></collision_cmd_vel_topic>
      <!-- auto: path if one is active, else velocity (default) / path / velocity -->
      <follow_mode>auto</follow_mode>
      <animation_name>walk</animation_name>
      <animation_factor>4.0</animation_factor>
      <linear_velocity>1.0</linear_velocity>
      <linear_tolerance>0.1</linear_tolerance>
    </plugin>
    <skin>
      <filename>model://walking_actor/meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>
    <animation name="walk">
      <filename>model://walking_actor/meshes/walk.dae</filename>
      <interpolate_x>false</interpolate_x>
    </animation>
  </actor>
</sdf>