<?xml version="1.0"?>
<sdf version="1.10">
  <model name="woman">
    <static>false</static>
    <link name="link">
      <!-- Gazebo は z 軸が高さ軸，モデルは y 軸が高さ軸のため調整 -->
      <pose>0 0 0 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://woman/meshes/woman.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://woman/meshes/woman.glb</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>