<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gz_human_sim</name>
  <version>0.0.0</version>
  <description>Gazebo human interaction tools and launch files.</description>
  <maintainer email="ksuzuki9541@gmail.com">rg-suzuki-ko</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>python3-yaml</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_interfaces</depend>
  <!-- The *_vendor keys are the ones rosdep knows on Jazzy; the bare
       library names (gz-sim8 etc.) are what CMake's find_package() wants
       but are not rosdep keys, so declaring those made `rosdep install`
       report "Cannot locate rosdep definition" and skip Gazebo entirely
       on a machine that did not already have it. -->
  <depend>gz_plugin_vendor</depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_msgs_vendor</depend>
  <depend>gz_transport_vendor</depend>
  <depend>gz_gui_vendor</depend>
  <depend>gz_rendering_vendor</depend>
  <depend>qtbase5-dev</depend>
  <depend>qtdeclarative5-dev</depend>
  <depend>boost</depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
  <depend>unified_entity_control</depend>
</package>
